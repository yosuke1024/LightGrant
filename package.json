{
  "name": "lightgrant",
  "version": "0.1.0",
  "description": "Temporary GitHub access. Granted in Slack. Revoked automatically.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "generate:manifests": "tsx scripts/generate-manifests.ts"
  },
  "keywords": [
    "github",
    "slack",
    "jit",
    "access-control"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@slack/bolt": "^3.21.4",
    "better-sqlite3": "^11.1.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "octokit": "^4.0.2",
    "pino": "^9.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.6.0",
    "pino-pretty": "^11.2.1",
    "prettier": "^3.3.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "vite": "^6.4.3"
  }
}
