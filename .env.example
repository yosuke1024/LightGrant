# System configuration
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://example.up.railway.app
APP_SECRET=at-least-32-random-bytes-change-this-in-production
SETUP_TOKEN=at-least-32-random-bytes-change-this-in-production-must-be-32-bytes-or-more

# Persistence
DATABASE_PATH=/data/lightgrant.sqlite

# Slack configuration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
# "Sign in with Slack" (OpenID Connect) app credentials — found under
# Basic Information → App Credentials. Required for GitHub account linking.
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_APPROVAL_CHANNEL_ID=C0000000000
SLACK_AUDIT_CHANNEL_ID=C0000000000

# GitHub configuration
GITHUB_ORG=my-organization
GITHUB_APP_ID=123456
GITHUB_CLIENT_ID=Iv1.your-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_PRIVATE_KEY_BASE64=your-base64-encoded-private-key
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Application defaults & policies (Optional)
# DISPLAY_TIMEZONE=UTC
# DEFAULT_DURATION_MINUTES=60
# MAX_REQUEST_DURATION_MINUTES=480
# ALLOWED_DURATIONS_MINUTES=30,60,120,240,480
# REVOCATION_POLL_INTERVAL_SECONDS=30
# JOB_POLL_INTERVAL_SECONDS=2
# TEAM_CACHE_REFRESH_SECONDS=600
# POLICY_AUTHORITY_REFRESH_SECONDS=3600
# AUDIT_RETENTION_DAYS=365
# EXPORT_TOKEN_TTL_SECONDS=600
# LOG_LEVEL=info
# ADMIN_SLACK_USER_IDS=U123,U456
